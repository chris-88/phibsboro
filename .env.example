VITE_SUPABASE_URL=http://127.0.0.1:54321
# The value below is the anon key `supabase start` prints. It is fixed by the CLI version, identical on
# every machine, published in Supabase's own docs, and therefore committed (D38). Paste it verbatim.
# S1.1 pins the CLI version (SUPABASE_CLI_VERSION in ci.yml) and re-confirms this value against it.
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
VITE_APP_BASE_URL=http://localhost:5173
# Path the bundle is served from. '/' for the custom domain; the deploy workflow overrides this
# with /phibsboro/ while the site lives on the GitHub Pages project page (S0.5 deviation).
VITE_BASE_PATH=/
VITE_SENTRY_DSN=
VITE_SENTRY_RELEASE=local
VITE_SENTRY_ENVIRONMENT=local

# Local stack only, for tests/db and later tests/rls (D14, D38). Both are the CLI's fixed values,
# printed by `supabase start` on every machine: not secrets. Recorded here; the test helpers
# carry the same constants and read no environment, so a test can never reach a hosted project.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU
