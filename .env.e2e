# Build config for the Playwright `e2e` project (S2.5, D17, D58). Points the bundle at the CLI's
# local Supabase stack, so `vite build --mode e2e` + `vite preview` drives the seeded local
# database and never a hosted project. The mode is `e2e`, not `test`, on purpose: Vitest runs in
# `test` mode and copies a `.env.test` file's VITE_ keys into process.env, which would point the
# hosted RLS suite (tests/helpers/target.ts) at 127.0.0.1. A separate mode keeps the two apart.
# Every value here is a published local-development constant, not a secret (D38) — the same ones
# committed in .env.example.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
# The preview origin the e2e specs open, so an absolute event link built by the app stays on it.
VITE_APP_BASE_URL=http://127.0.0.1:4173
VITE_BASE_PATH=/
VITE_SENTRY_DSN=
VITE_SENTRY_RELEASE=e2e
VITE_SENTRY_ENVIRONMENT=e2e
